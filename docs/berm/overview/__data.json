{"type":"data","nodes":[{"type":"data","data":[{"stars":1},1],"uses":{}},{"type":"data","data":[{"sections":1},[2,8],{"title":3,"pages":4},"",[5],{"title":6,"slug":7},"Introduction","index",{"title":9,"pages":10},"berm",[11,14,17,20,23,26],{"title":12,"slug":13},"Overview","berm/overview",{"title":15,"slug":16},"Writing a Program","berm/writing-a-program",{"title":18,"slug":19},"The Guest API","berm/guest-api",{"title":21,"slug":22},"The Manifest","berm/manifest",{"title":24,"slug":25},"Publishing a Program","berm/publishing",{"title":27,"slug":28},"Running the Service","berm/service"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"description":3,"toc":4,"html":15,"prev":16,"next":19},"berm/overview","Overview","",[5,9,12],{"depth":6,"id":7,"text":8},2,"nothing-survives-the-call","Nothing survives the call",{"depth":6,"id":10,"text":11},"the-linker-is-the-boundary","The linker is the boundary",{"depth":6,"id":13,"text":14},"where-wasmtime-stops-and-berm-starts","Where wasmtime stops and berm starts","\u003Cp>A program is one WebAssembly module. berm pins it by hash, compiles it once, and\ninstantiates it per invocation: arguments go in through host calls, the result\ncomes back out through one, and nothing survives the call.\u003C/p>\n\u003Cpre class=\"shiki shiki-themes github-light github-dark\" style=\"--shiki-light:#24292e;--shiki-dark:#e1e4e8;--shiki-light-bg:#fff;--shiki-dark-bg:#24292e\" tabindex=\"0\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">let\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\"> calls \u003C/span>\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">=\u003C/span>\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\"> Calls\u003C/span>\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">::\u003C/span>\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">by_name\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">(\u003C/span>\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">call\u003C/span>\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">::\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\">DEFAULT_CALL_DEPTH\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">);\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">let\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\"> berm \u003C/span>\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">=\u003C/span>\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\"> Berm\u003C/span>\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">::\u003C/span>\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">new\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">(\u003C/span>\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">&#x26;\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">engine, calls, \u003C/span>\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">vec!\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">[], \u003C/span>\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">storage\u003C/span>\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">::\u003C/span>\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">Memory\u003C/span>\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">::\u003C/span>\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">new\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">());\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">berm\u003C/span>\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">.\u003C/span>\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">deploy\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">(\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">\"example\"\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">, \u003C/span>\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">&#x26;\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">wasm)\u003C/span>\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">?\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">;\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">let\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\"> outcome \u003C/span>\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">=\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\"> berm\u003C/span>\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">.\u003C/span>\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">call\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">(\u003C/span>\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">None\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">, \u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">\"example\"\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">, \u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">\"echo\"\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">, \u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">br#\"{\"query\":\"hello\"}\"#\u003C/span>\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">.\u003C/span>\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">to_vec\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">())\u003C/span>\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">.await?\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">;\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">match\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\"> outcome\u003C/span>\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">.\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">result {\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">    Ok\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">(result) \u003C/span>\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">=>\u003C/span>\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\"> println!\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">(\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">\"{result}\"\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">),\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">    Err\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">(failure) \u003C/span>\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">=>\u003C/span>\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\"> eprintln!\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">(\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">\"{failure}\"\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">),\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">}\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\n\u003Cp>Two levels of result, because two things can go wrong and they are not the same\nthing. The outer one is the host's: no such tool, a trap, a broken image. The\ninner one, \u003Ccode>Outcome::result\u003C/code>, is the program reporting failure through the ABI —\nwhich is a result the model should see and react to, not an error the host\nshould swallow.\u003C/p>\n\u003Ch2 id=\"nothing-survives-the-call\">\u003Ca href=\"#nothing-survives-the-call\">Nothing survives the call\u003C/a>\u003C/h2>\n\u003Cp>Every invocation gets a fresh instance, so guest memory is not carried between\ncalls. A program that wants something to outlive an invocation has to put it\nsomewhere a host is holding.\u003C/p>\n\u003Cp>This is the opposite of a container, and it is why there is no lifecycle to\nmanage — nothing to start, stop, or restart. What is expensive is compilation,\nnot instantiation, and compilation is paid once per image.\u003C/p>\n\u003Ch2 id=\"the-linker-is-the-boundary\">\u003Ca href=\"#the-linker-is-the-boundary\">The linker is the boundary\u003C/a>\u003C/h2>\n\u003Cp>A program reaches the world only through the \u003Cem>syscalls\u003C/em> it was given,\nand that list is the linker it is instantiated with. A call to anything else\ntraps because nothing is registered for the number naming it — not because a\ncheck ran and said no. There is no check to write, and none to forget.\u003C/p>\n\u003Cp>berm serves \u003Ccode>berm.call\u003C/code> itself, against the programs it holds, and the\nreads of the call's own context: its caller, its user, its client, the time,\n\u003Ccode>berm.trace\u003C/code> and \u003Ccode>berm.deny\u003C/code>. Everything else — state, logs, HTTP, a database, wakes — is a\n\u003Ccode>Syscall\u003C/code> the embedder passes to \u003Ccode>Berm::new\u003C/code>, and that list is the whole of\nwhat a guest can reach. berm's \u003Ccode>syscall\u003C/code> module builds the standard ones, and\nthe embedder supplies what they act on.\u003C/p>\n\u003Ch2 id=\"where-wasmtime-stops-and-berm-starts\">\u003Ca href=\"#where-wasmtime-stops-and-berm-starts\">Where wasmtime stops and berm starts\u003C/a>\u003C/h2>\n\u003Cp>wasmtime loads an image, generates native code for it, and calls it. It has no idea what a program is — no tools, no manifest, no arguments, no JSON.\u003C/p>\n\u003Cp>berm is the layer that decides those things: that a tool is an export named \u003Ccode>berm_tool_*\u003C/code>, that an image describes itself in a \u003Ccode>.berm.abi\u003C/code> section, and that arguments arrive as a blob the guest pulls in. Every syscall is the same number, request and staged reply, carried by one import, \u003Ccode>berm.syscall\u003C/code>.\u003C/p>",{"title":17,"slug":18},"Introduction","index",{"title":20,"slug":21},"Writing a Program","berm/writing-a-program"],"uses":{"params":["slug"]}}]}
